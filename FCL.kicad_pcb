	(footprint "fcl_local:FCL_BatteryBlock_Mount_M2.5_Pin2_A"
		(layer "B.Cu")
		(uuid "6f98aae9-cde8-4d5f-9e10-0938eda21259")
		(at 78 71)
		(descr "Mount for the FCL aluminium battery end block (MS3181-16 bayonet cap boss, 19.2 mm cell bore). One M2.5 screw from the far side into the tapped block (plated 2.7 hole, GND contact boss), one 2 mm dowel pin pressed into the block (NPTH 2.1). Origin = cell axis at the board edge; +x = into the board. Drawn mirrored in y so that, flipped top-bottom onto B, the screw is at (4.4, -9.7) and the pin at (3.0, +9.3) from the cell axis. Variant A (pin +9.3); variant B has the pin at +7.5. Block face is relieved 0.6 mm except the two bosses, so tracks may run under it.")
		(tags "battery block 18650 MS3181 bayonet mount screw dowel")
