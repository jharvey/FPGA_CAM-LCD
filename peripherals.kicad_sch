	(text "Distance sensor - ST VL53L1X (LCSC C190004), time-of-flight up to 4 m, I2C address 0x29 (default).\nOn the IMU bus. XSHUT <- FPGA N16 (TOF_XSHUT, R88 10k pull-up = on), GPIO1 -> FPGA N17 (TOF_INT, R89 10k pull-up).\nC92 100 nF + C93 4.7 uF at AVDD/AVDDVCSEL (pins 11/1). Mount at a board edge looking the same way as the camera;\nkeep the 27 deg field of view clear; a cover window needs ST crosstalk calibration."
		(exclude_from_sim no)
		(at 25.4 208.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ccb94625-a785-4720-9943-bdfebfcd59f8")
	)
