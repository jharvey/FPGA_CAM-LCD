				(size 0.9 0.9)
				(thickness 0.135)
			)
		)
	)
	(gr_text "Row pitch 20.5 mm (1.9 mm gap, 1.6 mm ribs). Cell length window 65.0-67.5 mm (flat/button-top)"
		(at 211.5 66.5 0)
		(layer "Dwgs.User")
		(uuid "0a144639-02bb-48b6-836d-d6d3d22f73c6")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
		)
	)
	(gr_text "Protected 69-70 mm cells do NOT fit. All cells same direction: + right (buttons), - left (springs)"
		(at 211.5 68.7 0)
		(layer "Dwgs.User")
		(uuid "0b8f26ef-bf05-4c00-a2da-46ea1d7c4490")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
		)
	)
	(gr_text "Contact plates must bear on the bay end walls: solder joints must not carry the spring force"
		(at 211.5 70.9 0)
		(layer "Dwgs.User")
		(uuid "b7ad2741-e62d-49a4-8f7b-2d88337bb20f")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
		)
	)
	(gr_text "TH1: 2 mm compressible thermal pad (e.g. 3 W/mK silicone) between TH1 and cell 2"
