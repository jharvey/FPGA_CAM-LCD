	(text "CFG1 = VDD -> 5 V ONLY"
		(exclude_from_sim no)
		(at 175.26 85.09 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8f024819-e5d9-461f-9a7f-aacfa18f4edf")
	)
	(text "SINGLE USB-C PORT (J17): power + data. CH224K PD sink, 5 V ONLY (higher-voltage PD charging deferred)\nPower: VBUS_C -> D55 SS34 -> +5V (TP4056 chargers, U16), in parallel with the (DNP) micro-B inputs.\n5 V ONLY: CH224K CFG1 (pin 9) tied to VDD = level mode CFG1=1 -> 5 V request; CFG2/CFG3 to GND. Never fit a CFG1 resistor.\nCC1/CC2 stay with the CH224K (internal Rd). CH224K in PD-only mode: its DP/DM are shorted together and NOT\nconnected to the connector, so they do not load the USB data pair.\nData: connector D+/D- (A6/B6, A7/B7 joined) -> U24 USBLC6-2SC6 ESD -> USB_DP / USB_DN -> ESP32-S3 GPIO20/19 (wifi sheet)."
		(exclude_from_sim no)
		(at 40.64 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bd338f3a-72db-4ef9-a6e3-7e9bb0c03e36")
	)
