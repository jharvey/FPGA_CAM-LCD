(footprint "FCL_BatteryBlock_Mount_M2.5_Pin2_B"
	(version 20241229)
	(generator "pcbnew")
	(layer "F.Cu")
	(descr "Mount for the FCL aluminium battery end block (MS3181-16 bayonet cap boss, 19.2 mm cell bore). One M2.5 screw from the far side into the tapped block (plated 2.7 hole, GND contact boss), one 2 mm dowel pin pressed into the block (NPTH 2.1). Origin = cell axis at the board edge; +x = into the board. Drawn mirrored in y so that, flipped top-bottom onto B, the screw is at (4.4, -9.7) and the pin at (3.0, +7.5) from the cell axis. Variant B (pin +7.5, clears the servo header); variant A has the pin at +9.3. Block face is relieved 0.6 mm except the two bosses, so tracks may run under it.")
	(tags "battery block 18650 MS3181 bayonet mount screw dowel")
	(property "Reference" "REF**"
		(at 2 3 90)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "BLOCK_MOUNT"
		(at 3.5 0 90)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Footprint" ""
		(at 0 0 0)
		(layer "F.Fab")
		(hide yes)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(attr through_hole exclude_from_pos_files)
	(fp_rect (start -3 -14) (end 0 14) (stroke (width 0.1) (type dash)) (fill no) (layer "F.Fab"))
	(fp_poly (pts (xy 0 -12.5) (xy 4 -12.5) (xy 4 -9.9) (xy 7 -9.9) (xy 7 12.5) (xy 0 12.5)) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
	(fp_circle (center 0 0) (end 9.6 0) (stroke (width 0.05) (type dash)) (fill no) (layer "F.Fab"))
	(fp_poly (pts (xy 0 -12.6) (xy 3.95 -12.6) (xy 3.95 -9.85) (xy 7.1 -9.85) (xy 7.1 12.6) (xy 0 12.6))
		(stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(fp_circle (center 4.4 9.7) (end 7.0 9.7) (stroke (width 0.05) (type solid)) (fill no) (layer "B.CrtYd"))
	(fp_circle (center 4.4 9.7) (end 6.9 9.7) (stroke (width 0.1) (type solid)) (fill no) (layer "B.Fab"))
	(fp_text user "M2.5" (at 4.4 9.7 0) (layer "B.Fab")
		(effects (font (size 1 1) (thickness 0.15)) (justify mirror))
	)
	(fp_text user "%R" (at 3.5 0 90) (layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(pad "1" thru_hole circle (at 4.4 9.7) (size 4.6 4.6) (drill 2.7) (layers "*.Cu" "*.Mask") (remove_unused_layers no))
	(pad "" np_thru_hole circle (at 3 -7.5) (size 2.1 2.1) (drill 2.1) (layers "*.Cu" "*.Mask"))
	(model "${KIPRJMOD}/footprints/fcl_local.3dshapes/FCL_BatteryBlock_MS3181_B.step"
		(offset (xyz 0 0 -0.09))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
