(footprint "FCL_BatteryBlock_Mount_MS3181_R"
	(version 20241229)
	(generator "pcbnew")
	(layer "F.Cu")
	(descr "Mount for the common FCL aluminium battery end block (MS3181-16 bayonet boss, 19.2 mm cell bore). The block has three M1.6 tapped holes, T1 (4.4, -9.7), T2 (2.6, +9.3) and T3 (3.4, +5.0), from the cell axis at the board edge; two are used per site. This footprint, right side, cell 2 (placed turned 180 deg): screws in T2 + T3. 1.8 mm holes; T1 / T2 are GND pads, T3 is a bare hole. Flat block face 0.5 mm off the PCB: one 0.5 mm washer between block and PCB at each screw. Drawn mirrored in y for the back side.")
	(tags "battery block 18650 MS3181 bayonet mount screw dowel")
	(property "Reference" "REF**"
		(at 2 3 90)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "BLOCK_MOUNT"
		(at 3.5 0 90)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Footprint" ""
		(at 0 0 0)
		(layer "F.Fab")
		(hide yes)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(attr through_hole exclude_from_pos_files)
	(fp_rect (start -3 -14) (end 0 14) (stroke (width 0.1) (type dash)) (fill no) (layer "F.Fab"))
	(fp_poly (pts (xy 0 -12.5) (xy 4 -12.5) (xy 4 -9.9) (xy 7 -9.9) (xy 7 12.5) (xy 0 12.5)) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
	(fp_circle (center 0 0) (end 9.6 0) (stroke (width 0.05) (type dash)) (fill no) (layer "F.Fab"))
	(fp_poly (pts (xy 0 -12.6) (xy 3.95 -12.6) (xy 3.95 -9.85) (xy 7.1 -9.85) (xy 7.1 12.6) (xy 0 12.6))
		(stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(fp_text user "%R" (at 3.5 0 90) (layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_circle (center 2.6 -9.3) (end 4.15 -9.3) (stroke (width 0.05) (type solid)) (fill no) (layer "B.CrtYd"))
	(fp_circle (center 2.6 -9.3) (end 4.10 -9.3) (stroke (width 0.1) (type solid)) (fill no) (layer "B.Fab"))
	(fp_text user "M1.6" (at 2.6 -9.3 0) (layer "B.Fab")
		(effects (font (size 0.6 0.6) (thickness 0.1)) (justify mirror))
	)
	(pad "1" thru_hole circle (at 2.6 -9.3) (size 3.0 3.0) (drill 1.8) (layers "*.Cu" "*.Mask") (remove_unused_layers no))
	(fp_circle (center 3.4 -5.0) (end 4.95 -5.0) (stroke (width 0.05) (type solid)) (fill no) (layer "B.CrtYd"))
	(fp_circle (center 3.4 -5.0) (end 4.90 -5.0) (stroke (width 0.1) (type solid)) (fill no) (layer "B.Fab"))
	(fp_text user "M1.6" (at 3.4 -5.0 0) (layer "B.Fab")
		(effects (font (size 0.6 0.6) (thickness 0.1)) (justify mirror))
	)
	(pad "" np_thru_hole circle (at 3.4 -5.0) (size 1.8 1.8) (drill 1.8) (layers "*.Cu" "*.Mask"))
	(model "${KIPRJMOD}/footprints/fcl_local.3dshapes/FCL_BatteryBlock_MS3181_A.step"
		(offset (xyz 0 0 -0.09))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
