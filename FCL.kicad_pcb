		(layer "Dwgs.User")
		(uuid "f8cd61c7-617b-41cb-b46f-af8b8be86078")
		(effects
			(font
				(size 0.9 0.9)
				(thickness 0.135)
			)
		)
	)
	(gr_text "keep switchers (TLV62569 L1-L3, AP3032 L4, TP4056) and VSYS/charge currents >= 15 mm away,"
		(at 211.5 82.299999 0)
