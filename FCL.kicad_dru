(version 1)

# JLCPCB 4-layer, high-reliability defaults live in the net classes (0.15/0.15 mm).
# Fine-pitch exceptions only where the geometry needs them. Units are required (KiCad 10).

(rule "BGA_U1_fanout"
	(constraint track_width (min 0.1mm) )
	(constraint clearance (min 0.1mm) )
	(constraint via_diameter (min 0.4mm) )
	(constraint hole_size (min 0.2mm) )
	(condition "A.intersectsArea('U1_BGA') || B.intersectsArea('U1_BGA')" )
)

(rule "fine_pitch_pads"
	(constraint clearance (min 0.1mm) )
	(condition "(A.Type == 'Pad' && (A.memberOfFootprint('U2') || A.memberOfFootprint('U21') || A.memberOfFootprint('U22') || A.memberOfFootprint('U23') || A.memberOfFootprint('U24') || A.memberOfFootprint('J7') || A.memberOfFootprint('J17') || A.memberOfFootprint('U12') || A.memberOfFootprint('U14') || A.memberOfFootprint('U16') || A.memberOfFootprint('U18') || A.memberOfFootprint('U19') || A.memberOfFootprint('U9') || A.memberOfFootprint('U10') || A.memberOfFootprint('U11') || A.memberOfFootprint('U13') || A.memberOfFootprint('U15') || A.memberOfFootprint('U8') || A.memberOfFootprint('U3') || A.memberOfFootprint('U4') || A.memberOfFootprint('U5') || A.memberOfFootprint('U17') || A.memberOfFootprint('U20') || A.memberOfFootprint('U7') || A.memberOfFootprint('J1'))) || (B.Type == 'Pad' && (B.memberOfFootprint('U2') || B.memberOfFootprint('U21') || B.memberOfFootprint('U22') || B.memberOfFootprint('U23') || B.memberOfFootprint('U24') || B.memberOfFootprint('J7') || B.memberOfFootprint('J17') || B.memberOfFootprint('U12') || B.memberOfFootprint('U14') || B.memberOfFootprint('U16') || B.memberOfFootprint('U18') || B.memberOfFootprint('U19') || B.memberOfFootprint('U9') || B.memberOfFootprint('U10') || B.memberOfFootprint('U11') || B.memberOfFootprint('U13') || B.memberOfFootprint('U15') || B.memberOfFootprint('U8') || B.memberOfFootprint('U3') || B.memberOfFootprint('U4') || B.memberOfFootprint('U5') || B.memberOfFootprint('U17') || B.memberOfFootprint('U20') || B.memberOfFootprint('U7') || B.memberOfFootprint('J1')))" )
)

# ULX3S core copied from the reference board (5-mil rules, proven at the fab)
(rule "ULX3S_core_copy"
	(constraint clearance (min 0.127mm) )
	(constraint hole_to_hole (min 0.3mm) )
	(constraint hole_clearance (min 0.15mm) )
	(constraint track_width (min 0.1mm) )
	(condition "A.intersectsArea('ULX3S_CORE') || B.intersectsArea('ULX3S_CORE')" )
)
