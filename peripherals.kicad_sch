	(text "Microphone - TDK ICS-43434 (LCSC C5656610), I2S, bottom port: needs a ~0.8 mm hole through the PCB under the port\nand an opening in the case. L/R = GND -> left slot. Shares BCLK/WS with the amplifier (ESP32-S3 I2S0, full duplex).\nESP32: I2S_BCLK GPIO35, I2S_WS GPIO36, I2S_SPK GPIO37 (out), I2S_MIC GPIO38 (in), AMP_SD GPIO47. C94 100 nF at VDD."
		(exclude_from_sim no)
		(at 167.64 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1e501ff0-45d9-4fc4-b282-cbe77006d008")
	)
