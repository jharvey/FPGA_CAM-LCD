	(text "Barometer - ST LPS22DF (LCSC C3253714), I2C address 0x5C (SA0 = GND), CS high = I2C.\nOn the IMU bus (pull-ups R76/R77 on the imu sheet). INT_DRDY -> FPGA ball M17 (BARO_INT).\nC90 100 nF at VDD (pin 10), C91 100 nF at Vdd_IO (pin 1). Keep the vent hole clear; no conformal coat."
		(exclude_from_sim no)
		(at 25.4 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d5fb31ca-50be-4f54-8c3a-bc5a51d599b9")
	)
