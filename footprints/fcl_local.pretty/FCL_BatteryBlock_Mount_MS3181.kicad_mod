(footprint "FCL_BatteryBlock_Mount_MS3181"
	(version 20241229)
	(generator "pcbnew")
	(layer "F.Cu")
	(descr "Mount for the common FCL aluminium battery end block (MS3181-16 bayonet boss, 19.2 mm cell bore), flange 7 x 25 mm. Two M1.6 screws, one each side of the cell: S1 (4.4, -9.7) and S2 (3.5, +9.3) from the cell axis at the board edge. Both are 3.0 mm GND pads with 1.8 mm holes. The screws go in from the camera side and thread into the block: the screw head on the GND ring is the electrical connection. Kapton tape between block and PCB. Same footprint at all three cells (cell 2: turned 180 deg). Drawn mirrored in y for the back side.")
	(tags "battery block 18650 MS3181 bayonet mount screw dowel")
	(property "Reference" "REF**"
		(at 2 3 90)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "BLOCK_MOUNT"
		(at 3.5 0 90)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Footprint" ""
		(at 0 0 0)
		(layer "F.Fab")
		(hide yes)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(attr through_hole exclude_from_pos_files)
	(fp_rect (start -3 -14) (end 0 14) (stroke (width 0.1) (type dash)) (fill no) (layer "F.Fab"))
	(fp_poly (pts (xy 0 -12.5) (xy 7 -12.5) (xy 7 12.5) (xy 0 12.5)) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
	(fp_circle (center 0 0) (end 9.6 0) (stroke (width 0.05) (type dash)) (fill no) (layer "F.Fab"))
	(fp_poly (pts (xy 0 -12.6) (xy 7.1 -12.6) (xy 7.1 12.6) (xy 0 12.6))
		(stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(fp_text user "%R" (at 3.5 0 90) (layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_circle (center 4.4 9.7) (end 5.95 9.7) (stroke (width 0.05) (type solid)) (fill no) (layer "B.CrtYd"))
	(fp_circle (center 4.4 9.7) (end 5.90 9.7) (stroke (width 0.1) (type solid)) (fill no) (layer "B.Fab"))
	(fp_text user "M1.6" (at 4.4 9.7 0) (layer "B.Fab")
		(effects (font (size 0.6 0.6) (thickness 0.1)) (justify mirror))
	)
	(pad "1" thru_hole circle (at 4.4 9.7) (size 3.0 3.0) (drill 1.8) (layers "*.Cu" "*.Mask") (remove_unused_layers no))
	(fp_circle (center 3.5 -9.3) (end 5.05 -9.3) (stroke (width 0.05) (type solid)) (fill no) (layer "B.CrtYd"))
	(fp_circle (center 3.5 -9.3) (end 5.00 -9.3) (stroke (width 0.1) (type solid)) (fill no) (layer "B.Fab"))
	(fp_text user "M1.6" (at 3.5 -9.3 0) (layer "B.Fab")
		(effects (font (size 0.6 0.6) (thickness 0.1)) (justify mirror))
	)
	(pad "1" thru_hole circle (at 3.5 -9.3) (size 3.0 3.0) (drill 1.8) (layers "*.Cu" "*.Mask") (remove_unused_layers no))
	(model "${KIPRJMOD}/footprints/fcl_local.3dshapes/FCL_BatteryBlock_MS3181_A.step"
		(offset (xyz 0 0 -0.09))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
